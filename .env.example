# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- OpenRouter (chat + embeddings share one key) --------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat model used for query parsing and compliance assessment.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Comma-separated fallbacks, tried in order if the primary model errors.
OPENROUTER_FALLBACK_MODELS=openai/gpt-4.1-mini,google/gemini-2.5-flash

# Embedding model. NOTE: changing this changes EMBEDDING_DIM and requires
# rebuilding the Qdrant collection (`python scripts/ingest.py --recreate`).
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
# Provider routing. OpenRouter serves a model from many providers whose
# throughput varies ~8x; 'throughput' picks the fastest. Empty = default routing.
OPENROUTER_PROVIDER_SORT=throughput

# The configured model is a reasoning model. Its reasoning pass can consume the
# entire max_tokens budget and return no content at all. Both agent calls are
# structured extraction, where reasoning bought nothing: off is 4x faster.
LLM_REASONING_ENABLED=false


# --- Qdrant Cloud ----------------------------------------------------------
# Cluster URL and key from https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=sharia_corpus

# --- Retrieval tuning ------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
# Set false in sensitive environments to omit full prompt text from logs.
LOG_PROMPTS=true
LOG_FILE=logs/app.jsonl
